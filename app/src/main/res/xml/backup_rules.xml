<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11. The same rules as data_extraction_rules.xml: the cloud gets the data only
     end-to-end encrypted, a transfer to a new device always. What the keyboard learned
     (files/personal) stays out of both: Android 11 cannot tell them apart, and the cloud must
     not get it. -->
<full-backup-content>
    <include domain="file" path="." requireFlags="clientSideEncryption" />
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <exclude domain="file" path="personal/" />
</full-backup-content>
